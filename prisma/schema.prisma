// AIDa — Prisma schema
// Hackathon scope: only what we need to power the demo flow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  language      String   @default("ms") // ms | en | zh | ta
  age           Int
  state         String
  householdSize Int
  monthlyIncome Int
  citizenship   String   @default("malaysian")
  hasOKUCard    Boolean  @default(false)
  religion      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications Application[]
}

// The aid catalog is canonical in src/data/aids.json (BA1 schema, multilingual
// names, tiered amounts, structured eligibility). The DB mirror is intentionally
// schema-light — store the full aid object as Json — so catalog updates don't
// require a migration. Demo flow never reads from the DB; this model exists so
// Application.aidId has something to reference.
model Aid {
  id   String @id
  slug String @unique
  data Json

  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  aidId     String
  status    String   @default("eligible") // eligible | applied | approved | rejected
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  aid  Aid  @relation(fields: [aidId], references: [id])

  @@unique([userId, aidId])
}
